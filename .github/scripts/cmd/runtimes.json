[
  {
    "name": "kreivo",
    "package": "kreivo-runtime",
    "path": "runtime/kreivo",
    "build_extra_features": "",
    "build_env": {
      "SKIP_PALLET_REVIVE_FIXTURES": "1"
    },
    "benchmarks_templates": {
      "pallet_xcm_benchmarks::generic": "templates/xcm-bench-template.hbs",
      "pallet_xcm_benchmarks::fungible": "templates/xcm-bench-template.hbs"
    },
    "benchmarks_exclude_pallets": [
      "pallet_nfts"
    ],
    "benchmarks_scratch_pallets": [
      "pass_webauthn",
      "pass_substrate_keys"
    ]
  }
]
